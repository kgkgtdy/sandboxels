modCategories.bell = {
    color: "#ffdd55",
    icon: "🔔"
};

elements.chime = {
    color: "#ffee88",
    state: "gas",
    density: 1,
    category: "bell",

    tick(pixel) {

        pixel.vx *= 0.95;
        pixel.vy *= 0.95;

        if (Math.random() < 0.1) {
            deletePixel(pixel.x, pixel.y);
        }
    }
};

function dong(x, y, color) {

    for (let i = 0; i < 40; i++) {

        let angle = Math.random() * Math.PI * 2;

        createPixel("chime", x, y);

        let p = pixelMap[x]?.[y];

        if (p) {

            p.color = color;

            p.vx = Math.cos(angle) * (Math.random() * 3);

            p.vy = Math.sin(angle) * (Math.random() * 3);
        }
    }
}

elements.ring = {
    color: "#ffffff",
    state: "gas",
    density: 1,
    category: "bell",

    tick(pixel) {

        if (pixel.age === undefined) {
            pixel.age = 0;
        }

        pixel.age++;

        // expanding phase
        if (pixel.age < 20) {

            pixel.vx *= 1.15;
            pixel.vy *= 1.15;
        }

        // destroy nearby pixels
        for (let dx = -1; dx <= 1; dx++) {

            for (let dy = -1; dy <= 1; dy++) {

                if (dx === 0 && dy === 0) continue;

                let nx = pixel.x + dx;
                let ny = pixel.y + dy;

                if (!outOfBounds(nx, ny) && !isEmpty(nx, ny, true)) {

                    let other = pixelMap[nx]?.[ny];

                    if (
                        other &&
                        other.element !== "ring" &&
                        other.element !== "bell"
                    ) {
                        deletePixel(nx, ny);
                    }
                }
            }
        }

        // retracting phase
        if (pixel.age > 20 && pixel.age < 40) {

            let dx = pixel.homeX - pixel.x;
            let dy = pixel.homeY - pixel.y;

            pixel.vx = dx * 0.15;
            pixel.vy = dy * 0.15;
        }

        // explosion
        if (pixel.age === 40) {

            explodeAt(pixel.homeX, pixel.homeY, 12);
        }

        // cleanup
        if (pixel.age > 45) {

            deletePixel(pixel.x, pixel.y);
        }
    }
};

function toll(cx, cy, amount, speed) {

    for (let i = 0; i < amount; i++) {

        let angle = (Math.PI * 2) * (i / amount);

        let px = Math.floor(cx + Math.cos(angle) * 2);

        let py = Math.floor(cy + Math.sin(angle) * 2);

        if (outOfBounds(px, py)) continue;

        createPixel("ring", px, py);

        let p = pixelMap[px]?.[py];

        if (p) {

            p.vx = Math.cos(angle) * speed;

            p.vy = Math.sin(angle) * speed;

            p.homeX = cx;

            p.homeY = cy;
        }
    }
}

elements.bell = {
    color: "#ffcc00",

    behavior: behaviors.WALL,

    category: "bell",

    state: "solid",

    density: 2000,

    tick(pixel) {

        if (pixel.phase === undefined) {
            pixel.phase = 0;
        }

        pixel.phase += 0.15;

        if (Math.sin(pixel.phase) > 0.9) {

            pixel.color = "#ffee55";
        }
        else {

            pixel.color = "#ffcc00";
        }
    },

    onMouseDown(pixel) {

        dong(pixel.x, pixel.y, "#ffee55");

        toll(pixel.x, pixel.y, 140, 3.5);
    }
};
